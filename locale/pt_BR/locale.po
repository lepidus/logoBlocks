msgstr "Adicionar logo"

msgid "plugins.block.logoBlocks.logo"
msgstr "Imagem do logo"

msgid "plugins.block.logoBlocks.requiredName"
msgstr "Informe um título de até 200 caracteres."

msgid "plugins.block.logoBlocks.invalidEntry"
msgstr "Informe o nome (até 200 caracteres) e um link HTTP ou HTTPS válido, ou deixe o link vazio."

msgid "plugins.block.logoBlocks.invalidImage"
msgstr "Não foi possível ler a imagem. Use PNG, JPEG ou GIF de até 5 MB e 12 milhões de pixels, com altura proporcional final de até 3000 px. Verifique também os limites de upload do servidor."

msgid "plugins.block.logoBlocks.imageRequired"
msgstr "Selecione a imagem do novo logo."

msgid "plugins.block.logoBlocks.gdRequired"
msgstr "O redimensionamento requer a extensão GD do PHP no servidor."

