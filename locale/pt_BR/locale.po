msgid "plugins.block.logoBlocks.displayName"
msgstr "Blocos de logos"

msgid "plugins.block.logoBlocks.description"
msgstr "Exibe blocos de logos na barra lateral ou acima do rodapé, com links opcionais e redimensionamento automático."

msgid "plugins.block.logoBlocks.title"
msgstr "Título do bloco"

msgid "plugins.block.logoBlocks.name"
