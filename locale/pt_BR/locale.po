"Language: pt_BR\n"

msgid "plugins.block.sponsorsBlock.displayName"
msgstr "Bloco de patrocinadores"

msgid "plugins.block.sponsorsBlock.description"
msgstr "Exibe logos de patrocinadores e indexadores na barra lateral, com links opcionais e redimensionamento automático."

msgid "plugins.block.sponsorsBlock.instructions"
msgstr "Adicione um logo por vez e salve. Os logos aparecem na ordem de inclusão. Para substituir um logo, marque sua remoção e envie a nova imagem."

msgid "plugins.block.sponsorsBlock.title"
msgstr "Título do bloco"

msgid "plugins.block.sponsorsBlock.name"
msgstr "Nome do patrocinador ou indexador (texto alternativo)"

msgid "plugins.block.sponsorsBlock.url"
msgstr "Link (opcional)"

msgid "plugins.block.sponsorsBlock.add"
msgstr "+ Adicionar logo"

msgid "plugins.block.sponsorsBlock.logo"
msgstr "Imagem do logo"

msgid "plugins.block.sponsorsBlock.imageHelp"
msgstr "PNG, JPEG ou GIF, até 5 MB e 12 milhões de pixels. A imagem será salva em PNG com largura de 150 px e altura proporcional (até 3000 px). A transparência é preservada; GIFs usam somente o primeiro quadro. Em caso de erro, selecione o arquivo novamente antes de salvar."

msgid "plugins.block.sponsorsBlock.requiredName"
msgstr "Informe um título de até 200 caracteres."

msgid "plugins.block.sponsorsBlock.invalidEntry"
msgstr "Informe o nome (até 200 caracteres) e um link HTTP ou HTTPS válido, ou deixe o link vazio."

msgid "plugins.block.sponsorsBlock.invalidImage"
msgstr "Não foi possível ler a imagem. Use PNG, JPEG ou GIF de até 5 MB e 12 milhões de pixels, com altura proporcional final de até 3000 px. Verifique também os limites de upload do servidor."

msgid "plugins.block.sponsorsBlock.imageRequired"
msgstr "Selecione a imagem do novo logo."

msgid "plugins.block.sponsorsBlock.gdRequired"
msgstr "O redimensionamento requer a extensão GD do PHP no servidor."

msgid "plugins.block.sponsorsBlock.writeError"
msgstr "Não foi possível salvar o logo. Verifique as permissões do diretório público da revista e selecione a imagem novamente."

msgid "plugins.block.sponsorsBlock.networkError"
msgstr "Não foi possível salvar. Verifique sua conexão e o limite de upload do servidor e tente novamente."


msgid "plugins.block.sponsorsBlock.logos"
msgstr "Logos cadastrados"

msgid "plugins.block.sponsorsBlock.empty"
msgstr "Nenhum logo cadastrado. Escolha um da galeria ou adicione um novo."

msgid "plugins.block.sponsorsBlock.link"
msgstr "Link"

msgid "plugins.block.sponsorsBlock.noLink"
msgstr "Sem link"

msgid "plugins.block.sponsorsBlock.gridHelp"
msgstr "Use “Galeria de logos” para acessar a galeria ou “+ Adicionar logo” para enviar uma imagem. Use as ações de cada linha para editar e excluir. As alterações nos logos são salvas imediatamente. O botão Salvar abaixo grava o título e as opções de exibição."

msgid "plugins.block.sponsorsBlock.replaceHelp"
msgstr "Para substituir a imagem, selecione um novo arquivo. Deixe o campo vazio para manter o logo atual."

msgid "plugins.block.sponsorsBlock.notFound"
msgstr "Este logo não está mais disponível. Reabra as configurações e tente novamente."

msgid "plugins.block.sponsorsBlock.showAboveFooter"
msgstr "Exibir o bloco também acima do rodapé."

msgid "plugins.block.sponsorsBlock.orderHelp"
msgstr "Arraste os logos pela alça de pontos para mudar a ordem"

msgid "plugins.block.sponsorsBlock.moveLogo"
msgstr "Mover logo"

msgid "plugins.block.sponsorsBlock.orderSaving"
msgstr "Salvando ordem…"

msgid "plugins.block.sponsorsBlock.orderSaved"
msgstr "Ordem salva."

msgid "plugins.block.sponsorsBlock.invalidOrder"
msgstr "Não foi possível confirmar a nova ordem. A ordem anterior foi restaurada na tela. Reabra as configurações para atualizar a lista antes de tentar novamente."

msgid "plugins.block.sponsorsBlock.grayscaleLogos"
msgstr "Ativar escala monocromática, ficam coloridas ao interagir."

msgid "plugins.block.sponsorsBlock.choose"
msgstr "Galeria de logos"

msgid "plugins.block.sponsorsBlock.galleryHelp"
msgstr "Insira o link específico do perfil do periódico, ou da página correspondente."

msgid "plugins.block.sponsorsBlock.galleryRequired"
msgstr "Selecione uma logo disponível na galeria."

msgid "plugins.block.sponsorsBlock.galleryEmpty"
msgstr "Nenhuma logo disponível na galeria."

msgid "plugins.block.sponsorsBlock.useLogo"
msgstr "Usar logo"

msgid "plugins.block.sponsorsBlock.crop"
msgstr "Recortar bordas"

msgid "plugins.block.sponsorsBlock.cropHelp"
msgstr "Marque para remover margens de cor uniforme ou transparentes. A prévia mostra o resultado antes de salvar. Na edição, selecione uma nova imagem para aplicar o recorte."

msgid "plugins.block.sponsorsBlock.preview"
msgstr "Prévia da imagem"

msgid "plugins.block.sponsorsBlock.previewLoading"
msgstr "Preparando prévia…"

msgid "plugins.block.sponsorsBlock.previewError"
msgstr "Não foi possível gerar a prévia. Verifique o formato e o tamanho da imagem e selecione-a novamente."

msgid "plugins.block.sponsorsBlock.selectLogo"
msgstr "Selecionar logo"

msgid "plugins.block.sponsorsBlock.imageSummary"
msgstr "Formatos sugeridos: PNG, JPEG ou GIF.\nRedimensiona para 150 px de largura."

msgid "plugins.block.sponsorsBlock.cropSummary"
msgstr "Remove margens transparentes ou de cor uniforme."

msgid "plugins.block.sponsorsBlock.urlPlaceholder"
msgstr "https://exemplo.org/perfil"

msgid "plugins.block.sponsorsBlock.customization"
msgstr "Personalização"

msgid "plugins.block.sponsorsBlock.linkHelp"
msgstr "Insira o link específico do perfil do periódico, ou da página correspondente."

msgid "plugins.block.sponsorsBlock.urlWithHelp"
msgstr "Link (opcional): Insira o endereço específico do perfil do periódico, ou da página correspondente."
