msgstr "Select an available logo from the gallery."

msgid "plugins.block.sponsorsBlock.galleryEmpty"
msgstr "No logos available in the gallery."

msgid "plugins.block.sponsorsBlock.crop"
msgstr "Crop borders"

msgid "plugins.block.sponsorsBlock.preview"
msgstr "Image preview"

msgid "plugins.block.sponsorsBlock.previewLoading"
msgstr "Preparing preview…"

