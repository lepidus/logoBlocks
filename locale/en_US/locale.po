msgstr "The preview could not be generated. Check the image format and size and select it again."

msgid "plugins.block.sponsorsBlock.selectLogo"
msgstr "Select logo"

msgid "plugins.block.sponsorsBlock.imageSummary"
msgstr "Suggested formats: PNG, JPEG or GIF.\nResizes to 150 px wide."

