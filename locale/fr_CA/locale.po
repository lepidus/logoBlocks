msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fr_CA\n"

msgid "plugins.block.sponsorsBlock.displayName"
msgstr "Blocs de logos"

msgid "plugins.block.sponsorsBlock.description"
msgstr "Affiche les logos des commanditaires et des indexeurs dans la barre latérale, avec des liens facultatifs et un redimensionnement automatique."

msgid "plugins.block.sponsorsBlock.instructions"
msgstr "Ajoutez un logo à la fois et enregistrez. Les logos apparaissent dans leur ordre d’ajout. Pour remplacer un logo, marquez-le pour suppression et téléversez une nouvelle image."

msgid "plugins.block.sponsorsBlock.title"
msgstr "Titre du bloc"

msgid "plugins.block.sponsorsBlock.name"
msgstr "Nom du commanditaire ou de l’indexeur (texte de remplacement)"

msgid "plugins.block.sponsorsBlock.url"
msgstr "Lien (facultatif)"

msgid "plugins.block.sponsorsBlock.add"
msgstr "Ajouter un logo"

msgid "plugins.block.sponsorsBlock.logo"
msgstr "Image du logo"

msgid "plugins.block.sponsorsBlock.imageHelp"
msgstr "PNG, JPEG ou GIF, jusqu’à 5 Mo et 12 millions de pixels. Les images sont enregistrées au format PNG avec une largeur de 150 px et une hauteur proportionnelle (jusqu’à 3000 px). La transparence est conservée; seule la première image des GIF est utilisée. Après une erreur, sélectionnez de nouveau le fichier avant d’enregistrer."

msgid "plugins.block.sponsorsBlock.requiredName"
msgstr "Saisissez un titre de 200 caractères maximum."

msgid "plugins.block.sponsorsBlock.invalidEntry"
msgstr "Saisissez un nom (200 caractères maximum) et un lien HTTP ou HTTPS valide, ou laissez le lien vide."

msgid "plugins.block.sponsorsBlock.invalidImage"
msgstr "Impossible de lire l’image. Utilisez un fichier PNG, JPEG ou GIF de 5 Mo et 12 millions de pixels maximum, avec une hauteur proportionnelle finale de 3000 px maximum. Vérifiez également les limites de téléversement du serveur."

msgid "plugins.block.sponsorsBlock.imageRequired"
msgstr "Sélectionnez une image pour le nouveau logo."

msgid "plugins.block.sponsorsBlock.gdRequired"
msgstr "Le redimensionnement nécessite l’extension GD de PHP sur le serveur."

msgid "plugins.block.sponsorsBlock.writeError"
msgstr "Impossible d’enregistrer le logo. Vérifiez les permissions du répertoire public de la revue et sélectionnez de nouveau l’image."

msgid "plugins.block.sponsorsBlock.networkError"
msgstr "Impossible d’enregistrer. Vérifiez votre connexion et la limite de téléversement du serveur, puis réessayez."

msgid "plugins.block.sponsorsBlock.logos"
msgstr "Logos enregistrés"

msgid "plugins.block.sponsorsBlock.empty"
msgstr "Aucun logo enregistré. Choisissez un logo dans la galerie ou ajoutez-en un nouveau."

msgid "plugins.block.sponsorsBlock.link"
msgstr "Lien"

msgid "plugins.block.sponsorsBlock.noLink"
msgstr "Aucun lien"

msgid "plugins.block.sponsorsBlock.gridHelp"
msgstr "Utilisez « Galerie de logos » pour ouvrir la galerie ou « Ajouter un logo » pour téléverser une image. Utilisez les actions de chaque ligne pour modifier et supprimer. Les changements des logos sont enregistrés immédiatement. Le bouton Enregistrer ci-dessous enregistre le titre et les options d’affichage."

msgid "plugins.block.sponsorsBlock.replaceHelp"
msgstr "Pour remplacer l’image, sélectionnez un nouveau fichier. Laissez le champ vide pour conserver le logo actuel."

msgid "plugins.block.sponsorsBlock.notFound"
msgstr "Ce logo n’est plus disponible. Ouvrez de nouveau les paramètres et réessayez."

msgid "plugins.block.sponsorsBlock.showAboveFooter"
msgstr "Afficher également le bloc au-dessus du pied de page."

msgid "plugins.block.sponsorsBlock.orderHelp"
msgstr "Faites glisser les logos à l’aide de la poignée à points pour modifier leur ordre"

msgid "plugins.block.sponsorsBlock.moveLogo"
msgstr "Déplacer le logo"

msgid "plugins.block.sponsorsBlock.orderSaving"
msgstr "Enregistrement de l’ordre…"

msgid "plugins.block.sponsorsBlock.orderSaved"
msgstr "Ordre enregistré."

msgid "plugins.block.sponsorsBlock.invalidOrder"
msgstr "Impossible de confirmer le nouvel ordre. L’ordre précédent a été rétabli à l’écran. Ouvrez de nouveau les paramètres pour actualiser la liste avant de réessayer."

msgid "plugins.block.sponsorsBlock.grayscaleLogos"
msgstr "Activer l’affichage monochrome, les logos apparaissent en couleur lors d’une interaction."

msgid "plugins.block.sponsorsBlock.choose"
msgstr "Galerie de logos"

msgid "plugins.block.sponsorsBlock.galleryHelp"
msgstr "Saisissez le lien spécifique du profil de la revue ou de la page correspondante."

msgid "plugins.block.sponsorsBlock.galleryRequired"
msgstr "Sélectionnez un logo disponible dans la galerie."

msgid "plugins.block.sponsorsBlock.galleryEmpty"
msgstr "Aucun logo disponible dans la galerie."

msgid "plugins.block.sponsorsBlock.useLogo"
msgstr "Utiliser le logo"

msgid "plugins.block.sponsorsBlock.crop"
msgstr "Rogner les bordures"

msgid "plugins.block.sponsorsBlock.cropHelp"
msgstr "Cochez pour supprimer les marges de couleur uniforme ou transparentes. L’aperçu montre le résultat avant l’enregistrement. Lors de la modification, sélectionnez une nouvelle image pour appliquer le rognage."

msgid "plugins.block.sponsorsBlock.preview"
msgstr "Aperçu de l’image"

msgid "plugins.block.sponsorsBlock.previewLoading"
msgstr "Préparation de l’aperçu…"

msgid "plugins.block.sponsorsBlock.previewError"
msgstr "Impossible de générer l’aperçu. Vérifiez le format et la taille de l’image, puis sélectionnez-la de nouveau."

msgid "plugins.block.sponsorsBlock.selectLogo"
msgstr "Sélectionner un logo"

msgid "plugins.block.sponsorsBlock.imageSummary"
msgstr "Formats suggérés : PNG, JPEG ou GIF.\nRedimensionne à 150 px de largeur."

msgid "plugins.block.sponsorsBlock.cropSummary"
msgstr "Supprime les marges transparentes ou de couleur uniforme."

msgid "plugins.block.sponsorsBlock.urlPlaceholder"
msgstr "https://exemple.org/profil"

msgid "plugins.block.sponsorsBlock.customization"
msgstr "Personnalisation du bloc"

msgid "plugins.block.sponsorsBlock.linkHelp"
msgstr "Saisissez le lien spécifique du profil de la revue ou de la page correspondante."

msgid "plugins.block.sponsorsBlock.urlWithHelp"
msgstr "Lien (facultatif) — Saisissez le lien spécifique du profil de la revue ou de la page correspondante."

msgid "plugins.block.sponsorsBlock.blocks"
msgstr "Liste des blocs"

msgid "plugins.block.sponsorsBlock.defaultBlockNotice"
msgstr "Indexeurs : il s’agit du bloc par défaut du système et il ne peut pas être supprimé."

msgid "plugins.block.sponsorsBlock.addBlock"
msgstr "Ajouter un bloc"

msgid "plugins.block.sponsorsBlock.createHelp"
msgstr "Enregistrez le nom du bloc. Cliquez ensuite sur le crayon pour ajouter et organiser ses logos."

msgid "plugins.block.sponsorsBlock.visibility"
msgstr "Afficher ce bloc dans la revue"

msgid "plugins.block.sponsorsBlock.visibilityError"
msgstr "Impossible d’enregistrer. Veuillez réessayer."

msgid "plugins.block.sponsorsBlock.editBlock"
msgstr "Modifier"

msgid "plugins.block.sponsorsBlock.deleteBlock"
msgstr "Supprimer"

msgid "plugins.block.sponsorsBlock.confirmDeleteBlock"
msgstr "Voulez-vous vraiment supprimer ce bloc et tous ses logos?"

msgid "plugins.block.sponsorsBlock.placementSidebar"
msgstr "Afficher dans la barre latérale de la revue"

msgid "plugins.block.sponsorsBlock.placementFooter"
msgstr "Afficher dans le pied de page de la revue"

msgid "plugins.block.sponsorsBlock.placementBoth"
msgstr "Afficher aux deux endroits"

msgid "plugins.block.sponsorsBlock.placementRequired"
msgstr "Sélectionnez où afficher le bloc."

msgid "plugins.block.sponsorsBlock.moveBlock"
msgstr "Déplacer le bloc"

msgid "plugins.block.sponsorsBlock.blockOrderHelp"
msgstr "Faites glisser la poignée pour réordonner les blocs ou utilisez les flèches haut et bas."
