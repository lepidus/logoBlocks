"Language: es_ES\n"

msgid "plugins.block.sponsorsBlock.displayName"
msgstr "Bloque de patrocinadores"

msgid "plugins.block.sponsorsBlock.description"
msgstr "Muestra los logos de patrocinadores e indexadores en la barra lateral, con enlaces opcionales y ajuste automático de tamaño."

msgid "plugins.block.sponsorsBlock.instructions"
msgstr "Añada un logo a la vez y guarde. Los logos aparecen en el orden en que se añaden. Para sustituir un logo, márquelo para eliminarlo y suba una nueva imagen."

msgid "plugins.block.sponsorsBlock.title"
msgstr "Título del bloque"

msgid "plugins.block.sponsorsBlock.name"
msgstr "Nombre del patrocinador o indexador (texto alternativo)"

msgid "plugins.block.sponsorsBlock.url"
msgstr "Enlace (opcional, comenzando con https:// o http://)"

msgid "plugins.block.sponsorsBlock.add"
msgstr "Añadir nuevo logo"

msgid "plugins.block.sponsorsBlock.logo"
msgstr "Imagen del logo"

msgid "plugins.block.sponsorsBlock.imageHelp"
msgstr "PNG, JPEG o GIF, hasta 5 MB y 12 millones de píxeles. Las imágenes se guardan como PNG con un ancho de 150 px y altura proporcional (hasta 3000 px). Se conserva la transparencia; los GIF utilizan solo el primer fotograma. Si ocurre un error, seleccione el archivo de nuevo antes de guardar."

msgid "plugins.block.sponsorsBlock.requiredName"
msgstr "Introduzca un título de hasta 200 caracteres."

msgid "plugins.block.sponsorsBlock.invalidEntry"
msgstr "Introduzca un nombre (hasta 200 caracteres) y un enlace HTTP o HTTPS válido, o deje el enlace vacío."

msgid "plugins.block.sponsorsBlock.invalidImage"
msgstr "No se pudo leer la imagen. Utilice PNG, JPEG o GIF de hasta 5 MB y 12 millones de píxeles, con una altura proporcional final de hasta 3000 px. Compruebe también los límites de carga del servidor."

msgid "plugins.block.sponsorsBlock.imageRequired"
msgstr "Seleccione una imagen para el nuevo logo."

msgid "plugins.block.sponsorsBlock.gdRequired"
msgstr "El ajuste de tamaño requiere la extensión GD de PHP en el servidor."

msgid "plugins.block.sponsorsBlock.writeError"
msgstr "No se pudo guardar el logo. Compruebe los permisos del directorio público de la revista y seleccione la imagen de nuevo."

msgid "plugins.block.sponsorsBlock.networkError"
msgstr "No se pudo guardar. Compruebe la conexión y el límite de carga del servidor e inténtelo de nuevo."

msgid "plugins.block.sponsorsBlock.logos"
msgstr "Logos registrados"

msgid "plugins.block.sponsorsBlock.empty"
msgstr "No hay logos registrados. Elija uno de la galería o añada uno nuevo."

msgid "plugins.block.sponsorsBlock.link"
msgstr "Enlace"

msgid "plugins.block.sponsorsBlock.noLink"
msgstr "Sin enlace"

msgid "plugins.block.sponsorsBlock.gridHelp"
msgstr "Use “Elegir logo” para abrir la galería o “Añadir nuevo logo” para subir una imagen. Use las acciones de cada fila para editar y eliminar. Los cambios en los logos se guardan inmediatamente. El botón Guardar inferior guarda el título y las opciones de visualización."

msgid "plugins.block.sponsorsBlock.replaceHelp"
msgstr "Para sustituir la imagen, seleccione un nuevo archivo. Deje el campo vacío para conservar el logo actual."

msgid "plugins.block.sponsorsBlock.notFound"
msgstr "Este logo ya no está disponible. Vuelva a abrir la configuración e inténtelo de nuevo."

msgid "plugins.block.sponsorsBlock.showAboveFooter"
msgstr "Mostrar los logos también encima del pie de página"

msgid "plugins.block.sponsorsBlock.orderHelp"
msgstr "Arrastre los logos por el asa de puntos para cambiar su orden. La secuencia se guarda automáticamente y se utiliza en la barra lateral y encima del pie de página. También puede enfocar el asa y utilizar las teclas de flecha arriba y abajo."

msgid "plugins.block.sponsorsBlock.moveLogo"
msgstr "Mover logo"

msgid "plugins.block.sponsorsBlock.orderSaving"
msgstr "Guardando el orden…"

msgid "plugins.block.sponsorsBlock.orderSaved"
msgstr "Orden guardado."

msgid "plugins.block.sponsorsBlock.invalidOrder"
msgstr "No se pudo confirmar el nuevo orden. Se ha restaurado el orden anterior en pantalla. Vuelva a abrir la configuración para actualizar la lista antes de intentarlo de nuevo."

msgid "plugins.block.sponsorsBlock.grayscaleLogos"
msgstr "Activar la escala de grises en los logos (mostrar colores al pasar el cursor o enfocar el enlace)"

msgid "plugins.block.sponsorsBlock.choose"
msgstr "Elegir logo"

msgid "plugins.block.sponsorsBlock.galleryHelp"
msgstr "Seleccione un logo y haga clic en “Usar logo”. El nombre y el enlace se completarán automáticamente; podrá editarlos después."

msgid "plugins.block.sponsorsBlock.galleryRequired"
msgstr "Seleccione un logo disponible en la galería."

msgid "plugins.block.sponsorsBlock.galleryEmpty"
msgstr "No hay logos disponibles en la galería."

msgid "plugins.block.sponsorsBlock.useLogo"
msgstr "Usar logo"
