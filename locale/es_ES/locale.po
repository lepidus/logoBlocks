"Language: es_ES\n"

msgid "plugins.block.logoBlocks.displayName"
msgstr "Bloques de logos"

msgid "plugins.block.logoBlocks.description"
msgstr "Muestra bloques de logos en la barra lateral o encima del pie de página, con enlaces opcionales y ajuste automático de tamaño."

msgid "plugins.block.logoBlocks.title"
msgstr "Título del bloque"

msgid "plugins.block.logoBlocks.name"
msgstr "Título del logo"

msgid "plugins.block.logoBlocks.url"
msgstr "Enlace (opcional)"

msgid "plugins.block.logoBlocks.add"
msgstr "Añadir logo"

msgid "plugins.block.logoBlocks.logo"
msgstr "Imagen del logo"

msgid "plugins.block.logoBlocks.requiredName"
msgstr "Introduzca un título de hasta 200 caracteres."

msgid "plugins.block.logoBlocks.invalidEntry"
msgstr "Introduzca un nombre (hasta 200 caracteres) y un enlace HTTP o HTTPS válido, o deje el enlace vacío."

msgid "plugins.block.logoBlocks.invalidImage"
msgstr "No se pudo leer la imagen. Utilice PNG, JPEG o GIF de hasta 5 MB y 12 millones de píxeles, con una altura proporcional final de hasta 3000 px. Compruebe también los límites de carga del servidor."

msgid "plugins.block.logoBlocks.imageRequired"
msgstr "Seleccione una imagen para el nuevo logo."

msgid "plugins.block.logoBlocks.gdRequired"
msgstr "El ajuste de tamaño requiere la extensión GD de PHP en el servidor."

msgid "plugins.block.logoBlocks.writeError"
msgstr "No se pudo guardar el logo. Compruebe los permisos del directorio público de la revista y seleccione la imagen de nuevo."

msgid "plugins.block.logoBlocks.networkError"
msgstr "No se pudo guardar. Compruebe la conexión y el límite de carga del servidor e inténtelo de nuevo."

msgid "plugins.block.logoBlocks.logos"
msgstr "Logos registrados"

msgid "plugins.block.logoBlocks.empty"
msgstr "No hay logos registrados. Elija uno de la galería o añada uno nuevo."

msgid "plugins.block.logoBlocks.link"
msgstr "Enlace"

msgid "plugins.block.logoBlocks.noLink"
msgstr "Sin enlace"

msgid "plugins.block.logoBlocks.notFound"
msgstr "Este logo ya no está disponible. Vuelva a abrir la configuración e inténtelo de nuevo."

msgid "plugins.block.logoBlocks.orderHelp"
msgstr "Arrastre los logos por el asa de puntos para cambiar su orden"

msgid "plugins.block.logoBlocks.moveLogo"
msgstr "Mover logo"

msgid "plugins.block.logoBlocks.orderSaving"
msgstr "Guardando el orden…"

msgid "plugins.block.logoBlocks.orderSaved"
msgstr "Orden guardado."

msgid "plugins.block.logoBlocks.invalidOrder"
msgstr "No se pudo confirmar el nuevo orden. Se ha restaurado el orden anterior en pantalla. Vuelva a abrir la configuración para actualizar la lista antes de intentarlo de nuevo."

msgid "plugins.block.logoBlocks.grayscaleLogos"
msgstr "Activar la escala monocromática, los logos se muestran en color al interactuar."

msgid "plugins.block.logoBlocks.choose"
msgstr "Galería de logos"

msgid "plugins.block.logoBlocks.galleryHelp"
msgstr "Introduzca la dirección específica del perfil de la revista o de la página correspondiente."

msgid "plugins.block.logoBlocks.galleryRequired"
msgstr "Seleccione un logo disponible en la galería."

msgid "plugins.block.logoBlocks.galleryEmpty"
msgstr "No hay logos disponibles en la galería."

msgid "plugins.block.logoBlocks.crop"
msgstr "Recortar bordes"

msgid "plugins.block.logoBlocks.preview"
msgstr "Vista previa de la imagen"

msgid "plugins.block.logoBlocks.previewLoading"
msgstr "Preparando vista previa…"

msgid "plugins.block.logoBlocks.previewError"
msgstr "No se pudo generar la vista previa. Compruebe el formato y el tamaño de la imagen y selecciónela de nuevo."

msgid "plugins.block.logoBlocks.selectLogo"
msgstr "Seleccionar logo"

msgid "plugins.block.logoBlocks.imageSummary"
msgstr "Formatos sugeridos: PNG, JPEG o GIF.\nRedimensiona a 150 px de ancho."

msgid "plugins.block.logoBlocks.cropSummary"
msgstr "Elimina márgenes transparentes o de color uniforme."

msgid "plugins.block.logoBlocks.urlPlaceholder"
msgstr "https://ejemplo.org/perfil"

msgid "plugins.block.logoBlocks.customization"
msgstr "Personalización del bloque"

msgid "plugins.block.logoBlocks.urlWithHelp"
msgstr "Enlace (opcional) — Introduzca la dirección específica del perfil de la revista o de la página correspondiente."

msgid "plugins.block.logoBlocks.blocks"
msgstr "Lista de bloques"

msgid "plugins.block.logoBlocks.addBlock"
msgstr "Añadir bloque"

msgid "plugins.block.logoBlocks.createHelp"
msgstr "Guarde el nombre del bloque. Después, haga clic en el lápiz para añadir y organizar sus logos."

msgid "plugins.block.logoBlocks.visibility"
msgstr "Mostrar este bloque en la revista"

msgid "plugins.block.logoBlocks.visibilityError"
msgstr "No se pudo guardar. Inténtelo de nuevo."

msgid "plugins.block.logoBlocks.editBlock"
msgstr "Editar"

msgid "plugins.block.logoBlocks.deleteBlock"
msgstr "Eliminar"

msgid "plugins.block.logoBlocks.confirmDeleteBlock"
msgstr "¿Está seguro de que desea eliminar este bloque y todos sus logos?"

msgid "plugins.block.logoBlocks.placementSidebar"
msgstr "Mostrar en la barra lateral de la revista"

msgid "plugins.block.logoBlocks.placementFooter"
msgstr "Mostrar en el pie de página de la revista"

msgid "plugins.block.logoBlocks.placementBoth"
msgstr "Mostrar en ambos lugares"

msgid "plugins.block.logoBlocks.placementRequired"
msgstr "Seleccione dónde mostrar el bloque."

msgid "plugins.block.logoBlocks.moveBlock"
msgstr "Mover bloque"

msgid "plugins.block.logoBlocks.blockOrderHelp"
msgstr "Arrastre el asa para ordenar los bloques o use las flechas arriba y abajo."

msgid "plugins.block.logoBlocks.updateLogo"
msgstr "Actualizar logo"

msgid "plugins.block.logoBlocks.acronym"
msgstr "Sigla (opcional)"

msgid "plugins.block.logoBlocks.invalidAcronym"
msgstr "Introduzca una sigla de hasta 30 caracteres o deje el campo vacío."

msgid "plugins.block.logoBlocks.logoDescription"
msgstr "Descripción (opcional)"

msgid "plugins.block.logoBlocks.descriptionPlacement"
msgstr "Visualización de la descripción de los logos"

msgid "plugins.block.logoBlocks.descriptionHidden"
msgstr "No mostrar"

msgid "plugins.block.logoBlocks.descriptionPlacementRequired"
msgstr "Seleccione dónde mostrar las descripciones de los logos."

msgid "plugins.block.logoBlocks.invalidDescription"
msgstr "Introduzca una descripción de hasta 100 caracteres o deje el campo vacío."
